# DevOps Control Plane — local development configuration
#
# Copy to .env and adjust. PLACEHOLDERS ONLY: never put a real credential in
# this file (docs/SECURITY.md §9, mandatory rule 3). .env is git-ignored;
# .env.example is committed, so anything written here is public.
#
# Every DCP_* variable must match a field on Settings in
# backend/app/core/config.py — an unrecognised DCP_* variable is a startup
# error, so a typo fails loudly instead of being silently ignored.

# --- deployment identity -----------------------------------------------------
# local | development | staging | production
DCP_ENVIRONMENT=local
# DEBUG is rejected outside 'local'.
DCP_LOG_LEVEL=INFO
DCP_API_BASE_PATH=/api/v1

# --- demonstration mode (AD-15) ---------------------------------------------
# true serves synthetic data and marks every affected response. Rejected
# outside 'local', so a real deployment can never accidentally enable it.
DCP_DEMO_MODE=true

# --- credentials: required, no defaults -------------------------------------
# The hostnames below are the Compose service names.
DCP_DATABASE_URL=postgresql+psycopg://dcp:placeholder-password@postgres:5432/dcp
DCP_REDIS_URL=redis://redis:6379/0

# --- tunables ----------------------------------------------------------------
DCP_DATABASE_STATEMENT_TIMEOUT_MS=5000
DCP_READINESS_TIMEOUT_SECONDS=3.0
# Comma-separated. '*' is rejected in every environment (docs/SECURITY.md §12).
# Empty is correct when the SPA is served from the same origin as the API.
DCP_CORS_ORIGINS=

# Host-side DSNs use 127.0.0.1, not localhost, on purpose: Compose publishes
# these ports on IPv4 loopback only, while `localhost` resolves to ::1 first on
# Windows. The IPv6 attempt is silently filtered, which without an explicit
# connect timeout hangs the connection instead of failing it.

# --- host port mappings ------------------------------------------------------
# Defaults avoid the usual conflicts: a developer machine often already runs
# PostgreSQL on 5432 or Redis on 6379. Container-to-container traffic always
# uses the standard ports, so DCP_DATABASE_URL above does not change.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- PostgreSQL container ----------------------------------------------------
POSTGRES_DB=dcp
POSTGRES_USER=dcp
POSTGRES_PASSWORD=placeholder-password

# --- integration tests -------------------------------------------------------
# Deliberately NOT DCP_-prefixed: that prefix is reserved for application
# settings, and an unrecognised DCP_* variable is a startup error by design, so
# a test-harness variable wearing it would force that guard to be loosened.
#
# Create the database once:
#   docker compose -f infra/compose/docker-compose.yml exec -T postgres #     psql -U dcp -d postgres -c 'CREATE DATABASE dcp_test OWNER dcp;'
#
# Unset, the integration suite skips. Set but unreachable, it fails.
TEST_DATABASE_URL=postgresql+psycopg://dcp:placeholder-password@127.0.0.1:5433/dcp_test

# --- not yet used ------------------------------------------------------------
# Added by the milestone that implements them, so that an unused variable here
# never implies a working integration:
#   M1.3  DCP_OIDC_ISSUER, DCP_OIDC_CLIENT_ID, DCP_OIDC_CLIENT_SECRET
#   M6.2  a separate non-superuser application role (OPEN-15)
#   M2.1  DCP_PROMETHEUS_URL
#   M3.2  DCP_LOKI_URL
#   M3.3  DCP_ALERT_WEBHOOK_SECRET
#   M4.x  DCP_SECRET_STORE_* (OPEN-06)
#   M5.1  DCP_JENKINS_BASE_URL, DCP_JENKINS_API_TOKEN
