# DevOps Control Plane — local development configuration
#
# Copy to .env and adjust. PLACEHOLDERS ONLY: never put a real credential in
# this file (docs/SECURITY.md §9, mandatory rule 3). .env is git-ignored;
# .env.example is committed, so anything written here is public.
#
# Every DCP_* variable must match a field on Settings in
# backend/app/core/config.py — an unrecognised DCP_* variable is a startup
# error, so a typo fails loudly instead of being silently ignored.

# --- deployment identity -----------------------------------------------------
# local | development | staging | production
DCP_ENVIRONMENT=local
# DEBUG is rejected outside 'local'.
DCP_LOG_LEVEL=INFO
DCP_API_BASE_PATH=/api/v1

# --- demonstration mode (AD-15) ---------------------------------------------
# true serves synthetic data and marks every affected response. Rejected
# outside 'local', so a real deployment can never accidentally enable it.
DCP_DEMO_MODE=true

# --- credentials: required, no defaults -------------------------------------
# The hostnames below are the Compose service names.
DCP_DATABASE_URL=postgresql+psycopg://dcp:placeholder-password@postgres:5432/dcp
DCP_REDIS_URL=redis://redis:6379/0

# --- OIDC (M1.3) -------------------------------------------------------------
# All four are required together; with any of them unset, /auth/login answers
# 503 not_configured rather than pretending to authenticate. The app still
# starts (PRD §11).
#
# The values below are the mock IdP in the `mocks` Compose profile. It is a
# DEVELOPMENT AID and checks no password — see infra/compose/mock-idp/README.md.
# Passing against it is not evidence that a real IdP works (OPEN-01).
#
# DCP_OIDC_ISSUER must be byte-exact: it is compared literally against the
# ID token's `iss` claim, and it is also the origin every discovered endpoint
# is checked against before being fetched.
DCP_OIDC_ISSUER=http://localhost:9000
DCP_OIDC_CLIENT_ID=dcp-local
# Placeholder. A real client secret comes from the secret store at runtime and
# never enters this file or the repository (docs/SECURITY.md §9).
DCP_OIDC_CLIENT_SECRET=placeholder-client-secret
# Registered with the IdP exactly. Not derived from the request's Host header.
DCP_OIDC_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback
# Space- or comma-separated. Must include openid.
DCP_OIDC_SCOPES=openid email profile
DCP_OIDC_CLOCK_SKEW_SECONDS=60
DCP_OIDC_HTTP_TIMEOUT_SECONDS=10.0
DCP_OIDC_METADATA_TTL_SECONDS=3600
DCP_OIDC_JWKS_MIN_REFRESH_SECONDS=60
DCP_OIDC_LOGIN_STATE_TTL_SECONDS=600

# --- sessions (docs/SECURITY.md §5) -----------------------------------------
# Both enforced server-side; a client clock is never trusted. Redis-only
# session store (OPEN-04 resolved: Redis-only; auth events still audited in
# PostgreSQL), so restarting Redis logs everyone out.
DCP_SESSION_IDLE_TIMEOUT_SECONDS=1800
DCP_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
# Cookie Secure is NOT configurable: it is derived from DCP_ENVIRONMENT, so
# only 'local' gets Secure=false. docs/SECURITY.md §5 permits that one
# deviation and nothing else.

# --- rate limiting (AD-19) ---------------------------------------------------
# The /auth/* class. Fails CLOSED when Redis is unavailable.
DCP_AUTH_RATE_LIMIT_MAX=10
DCP_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- tunables ----------------------------------------------------------------
DCP_DATABASE_STATEMENT_TIMEOUT_MS=5000
DCP_READINESS_TIMEOUT_SECONDS=3.0
# How long a dashboard aggregate may be served from Redis (API_CONTRACTS.md
# §13). Short on purpose: the dashboard is polled, so the cache absorbs a
# refresh interval rather than holding data. 0 disables caching, which is
# correct and slower — M1.6's documented rollback. The key includes the
# caller's resolved scope, so raising this does not widen who sees what.
# Note that a write is not reflected until the entry expires.
DCP_DASHBOARD_CACHE_TTL_SECONDS=15
# Comma-separated. '*' is rejected in every environment (docs/SECURITY.md §12).
# Empty is correct when the SPA is served from the same origin as the API.
DCP_CORS_ORIGINS=

# --- frontend (Vite, build/dev time — NOT DCP_-prefixed) ---------------------
# Read by the SPA through import.meta.env, so they are public by construction:
# never put a secret here. Compose sets VITE_DEV_PROXY_TARGET for the dev
# server; this one is the dashboard's auto-refresh interval in seconds
# (PRD §4.2 "refresh data automatically at a configurable interval").
# 0 turns auto-refresh off. Polling faster than
# DCP_DASHBOARD_CACHE_TTL_SECONDS just re-reads the same cached payload, which
# the displayed collected_at makes visible rather than hiding.
VITE_DASHBOARD_REFRESH_SECONDS=30

# Host-side DSNs use 127.0.0.1, not localhost, on purpose: Compose publishes
# these ports on IPv4 loopback only, while `localhost` resolves to ::1 first on
# Windows. The IPv6 attempt is silently filtered, which without an explicit
# connect timeout hangs the connection instead of failing it.

# --- host port mappings ------------------------------------------------------
# MOCK_IDP_HOST_PORT is published by the `backend` service, not by `mock-idp`:
# the mock shares the backend's network namespace so that one issuer URL is
# correct from both the browser and the backend.
# Defaults avoid the usual conflicts: a developer machine often already runs
# PostgreSQL on 5432 or Redis on 6379. Container-to-container traffic always
# uses the standard ports, so DCP_DATABASE_URL above does not change.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
MOCK_IDP_HOST_PORT=9000

# --- PostgreSQL container ----------------------------------------------------
POSTGRES_DB=dcp
POSTGRES_USER=dcp
POSTGRES_PASSWORD=placeholder-password

# --- integration tests -------------------------------------------------------
# Deliberately NOT DCP_-prefixed: that prefix is reserved for application
# settings, and an unrecognised DCP_* variable is a startup error by design, so
# a test-harness variable wearing it would force that guard to be loosened.
#
# Create the database once:
#   docker compose -f infra/compose/docker-compose.yml exec -T postgres #     psql -U dcp -d postgres -c 'CREATE DATABASE dcp_test OWNER dcp;'
#
# Unset, the integration suite skips. Set but unreachable, it fails.
TEST_DATABASE_URL=postgresql+psycopg://dcp:placeholder-password@127.0.0.1:5433/dcp_test

# --- not yet used ------------------------------------------------------------
# Added by the milestone that implements them, so that an unused variable here
# never implies a working integration:
#   M6.2  a separate non-superuser application role (OPEN-15)
#   M2.1  DCP_PROMETHEUS_URL
#   M3.2  DCP_LOKI_URL
#   M3.3  DCP_ALERT_WEBHOOK_SECRET
#   M4.x  DCP_SECRET_STORE_* (OPEN-06)
#   M5.1  DCP_JENKINS_BASE_URL, DCP_JENKINS_API_TOKEN
